# Frontend environment variables — copy sang .env.local rồi điền giá trị thật.
# LƯU Ý: mọi biến NEXT_PUBLIC_* được nhúng vào bundle lúc BUILD và nhìn thấy được ở trình duyệt.
# Không bao giờ đặt secret vào biến NEXT_PUBLIC_*.

# Gốc API của backend — địa chỉ mà TRÌNH DUYỆT gọi được (không phải tên service docker)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# URL công khai của chính FE (link trong email, redirect OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — client id (public theo thiết kế của Google, nhưng vẫn không commit file .env.local)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Playwright e2e (T23) ─────────────────────────────────────────────
# Bỏ trống khi chạy trên máy: playwright.config.ts mặc định :3000 / :5000.
# Đổi khi chạy trong docker compose hoặc trên môi trường khác.
# E2E_BASE_URL=http://localhost:3000
# E2E_API_URL=http://localhost:5000/api/v1
E2E_EMAIL=fixture@flintflow.io
E2E_PASSWORD=fixture-password-123
